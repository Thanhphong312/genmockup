{
  "name": "genmockupbullstart",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "prisma:generate": "pnpm --filter api exec prisma generate",
    "prisma:migrate": "pnpm --filter api exec prisma migrate dev",
    "prisma:studio": "pnpm --filter api exec prisma studio",
    "prisma:deploy": "pnpm --filter api exec prisma migrate deploy",
    "migrate:sqlite-to-mysql": "pnpm --filter api exec tsx scripts/migrate-sqlite-to-mysql.ts",
    "seed": "pnpm --filter api exec tsx scripts/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3"
  }
}
