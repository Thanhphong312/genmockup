{
  "manifest_version": 3,
  "name": "PrimeHorizonMockup",
  "version": "1.0.1",
  "description": "Lưu ảnh ChatGPT vào thư viện ý tưởng, generate mockup và quản lý bộ áo — kết nối app Bullstart.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "downloads"],
  "host_permissions": [
    "https://genmockup.primehorizon.studio/*",
    "http://localhost:3000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PrimeHorizonMockup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
