# API server
PORT=3000

# MySQL 8. Database phải để utf8mb4.
#   Ký tự đặc biệt trong mật khẩu phải URL-encode (@ -> %40, # -> %23, / -> %2F).
#   Thêm ?connection_limit=10 nếu muốn giới hạn pool (mặc định Prisma = số CPU * 2 + 1).
DATABASE_URL="mysql://genmockup:CHANGE_ME@127.0.0.1:3306/genmockup"

# Lưu ý: `prisma migrate dev` (chỉ dùng ở máy dev, khi tạo migration mới) cần dựng
# một "shadow database" tạm nên user DB phải có quyền CREATE/DROP DATABASE.
# Trên server production chỉ chạy `prisma migrate deploy` — không cần quyền đó.

# Storage ảnh (relative to repo root, hoặc đường dẫn tuyệt đối)
STORAGE_DIR=./storage

# Public URL (dùng để build link ảnh trả ra cho client)
PUBLIC_URL=http://localhost:3000

# CORS — comma separated origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# API key (optional, để trống tắt check)
API_KEY=

# Tính năng phân tích & tạo ý tưởng (New Idea). off/0/false = tạm khóa; trống = bật
FEATURE_IDEAS=

# Auth LUÔN BẬT. Hai biến dưới chỉ dùng để tạo admin đầu tiên lúc boot,
# để trống thì mặc định admin/admin — đổi mật khẩu ngay sau lần đăng nhập đầu.
AUTH_USERNAME=
AUTH_PASSWORD=
# BẮT BUỘC đặt cố định ở production: bỏ trống thì mỗi lần restart sinh secret mới,
# toàn bộ session web + token extension chết sạch. Sinh bằng: openssl rand -hex 32
AUTH_SECRET=change-me-random-string-for-jwt-signing

# Chỉ là fallback khi user chưa tự nhập key trong trang Cài đặt
OPENAI_API_KEY=

# Google Drive — OAuth 2.0 (để trống tắt feature)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/drive/oauth/callback
GOOGLE_OAUTH_TOKEN_FILE=./secrets/drive-token.json
GOOGLE_DRIVE_PARENT_FOLDER_ID=
